<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.wadahiro.keycloak.testframework</groupId>
        <artifactId>keycloak-test-framework-extensions-parent</artifactId>
        <version>0.2.0</version>
    </parent>
    <artifactId>undertow-integration-tests</artifactId>
    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.keycloak.testframework</groupId>
                <artifactId>keycloak-test-framework-bom</artifactId>
                <version>${framework.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>io.github.wadahiro.keycloak.testframework</groupId>
            <artifactId>keycloak-test-framework-undertow</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.wadahiro.keycloak.testframework</groupId>
            <artifactId>undertow-spi-fixture</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.wadahiro.keycloak.testframework</groupId>
            <artifactId>keycloak-test-framework-saml</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.wadahiro.keycloak.testframework</groupId>
            <artifactId>keycloak-test-framework-broker</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.wadahiro.keycloak.testframework</groupId>
            <artifactId>keycloak-test-framework-ldap</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.keycloak.testframework</groupId>
            <artifactId>keycloak-test-framework-oauth</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>io.github.wadahiro.keycloak.testframework</groupId>
                <artifactId>keycloak-test-runtime-maven-plugin</artifactId>
                <version>${project.version}</version>
                <executions>
                    <execution>
                        <id>prepare-keycloak-runtime</id>
                        <phase>process-test-classes</phase>
                        <goals><goal>prepare</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <jvm>${java.home}/bin/java</jvm>
                    <runOrder>alphabetical</runOrder>
                    <argLine>-Djava.util.logging.manager=org.jboss.logmanager.LogManager</argLine>
                    <systemPropertyVariables>
                        <kc.test.server>undertow-process</kc.test.server>
                        <kc.test.keycloak>undertow-admin</kc.test.keycloak>
                        <kc.test.undertow.java.home>${keycloak.java.home}</kc.test.undertow.java.home>
                        <kc.test.undertow.work>${project.build.directory}/undertow-runs</kc.test.undertow.work>
                        <expected.server.version>${tested.keycloak.version}</expected.server.version>
                        <expected.server.java>${tested.server.java}</expected.server.java>
                        <unit.java.home>${unit.java.home}</unit.java.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>runtime15</id>
                <activation><activeByDefault>true</activeByDefault></activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.github.wadahiro.keycloak.testframework</groupId>
                        <artifactId>keycloak-test-runtime-maven-plugin</artifactId>
                        <version>${project.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>io.github.wadahiro.keycloak.testframework</groupId>
                                <artifactId>keycloak-test-runtime-undertow15</artifactId>
                                <version>${project.version}</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
