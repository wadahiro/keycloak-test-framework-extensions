# Example schema in OpenLDAP slapd.conf syntax.
# 1.3.6.1.4.1.32473 is the example enterprise number reserved for documentation (RFC 5612).
objectidentifier xExampleRoot 1.3.6.1.4.1.32473.1
objectIdentifier xExampleAttributes xExampleRoot:1
ObjectIdentifier xExampleClasses xExampleRoot:2

attributetype ( xExampleAttributes:1
    NAME 'x-example-badgeNumber'
    DESC 'Badge number of a person'
    EQUALITY caseIgnoreMatch
    SUBSTR caseIgnoreSubstringsMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{64}
    SINGLE-VALUE )

# A multi-valued attribute.
AttributeType ( xExampleAttributes:2 NAME 'x-example-project'
    DESC 'Projects a person works on'
    EQUALITY caseIgnoreMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

objectclass ( xExampleClasses:1 NAME 'x-example-person'
    DESC 'Example auxiliary class for people'
    SUP top AUXILIARY
    MAY ( x-example-badgeNumber $ x-example-project ) )
