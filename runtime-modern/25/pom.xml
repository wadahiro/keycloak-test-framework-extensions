<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.wadahiro.keycloak.testframework</groupId>
        <artifactId>keycloak-test-runtime-modern-parent</artifactId>
        <version>0.1.0</version>
    </parent>
    <artifactId>keycloak-test-runtime-undertow25</artifactId>
    <properties>
        <runtime.version>25.0.6</runtime.version>
        <runtime.major>25</runtime.major>
        <runtime.java>21</runtime.java>
        <servlet.namespace>jakarta</servlet.namespace>
        <servlet.artifact>jakarta.servlet-api</servlet.artifact>
        <servlet.group>jakarta.servlet</servlet.group>
        <servlet.version>6.0.0</servlet.version>
        <config.templates>${project.basedir}/../src/main/config-factory</config.templates>
        <runtime.undertow.version>2.3.2.Final</runtime.undertow.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-services</artifactId>
            <version>${runtime.version}</version>
            <type>test-jar</type>
            <scope>compile</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>