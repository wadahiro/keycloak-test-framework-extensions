# Example custom schema as an OpenLDAP cn=config entry.
# 1.3.6.1.4.1.32473 is the example enterprise number reserved for documentation (RFC 5612).
dn: cn=x-example,cn=schema,cn=config
objectClass: olcSchemaConfig
cn: x-example
olcObjectIdentifier: {0}xExampleRoot 1.3.6.1.4.1.32473.1
olcAttributeTypes: {0}( xExampleRoot:1.1 NAME 'x-example-badgeNumber'
  DESC 'Badge number of a person' EQUALITY caseIgnoreMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{64} SINGLE-VALUE )
olcObjectClasses: {0}( xExampleRoot:2.1 NAME 'x-example-person'
  DESC 'Example auxiliary class for people' SUP top AUXILIARY
  MAY x-example-badgeNumber )
