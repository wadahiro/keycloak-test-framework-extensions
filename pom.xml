<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.wadahiro.keycloak.testframework</groupId>
    <version>0.1.1-SNAPSHOT</version>
    <artifactId>keycloak-test-framework-extensions-parent</artifactId>
    <packaging>pom</packaging>
    <name>Keycloak Test Framework Extensions</name>
    <description>Keycloak Test Framework extensions for isolated runtimes, H2 reset, browser login, identity brokering, and LDAP federation tests.</description>
    <url>https://github.com/wadahiro/keycloak-test-framework-extensions</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>
    <modules>
        <module>runtime-undertow15</module>
        <module>extension-undertow</module>
        <module>extension-saml</module>
        <module>extension-broker</module>
        <module>extension-ldap</module>
        <module>examples/java11-unit-tests</module>
        <module>runtime-classpath-maven-plugin</module>
        <module>undertow-integration-tests</module>
    </modules>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <framework.version>26.8.2</framework.version>
        <keycloak.java.home>${env.KEYCLOAK_JAVA_HOME}</keycloak.java.home>
        <unit.java.home>${keycloak.java.home}</unit.java.home>
        <tested.keycloak.version>15.0.2</tested.keycloak.version>
        <tested.server.java>11</tested.server.java>
        <unboundid.version>7.0.5</unboundid.version>
        <kc.test.undertow.version>${tested.keycloak.version}</kc.test.undertow.version>
    </properties>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.4</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>3.5.4</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.8.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.1.4</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
    <profiles>
        <profile>
            <id>publishing</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>keycloak20</id>
            <modules>
                <module>runtime-modern</module>
                <module>runtime-modern/20</module>
            </modules>
            <properties>
                <unit.java.home>${env.JAVA11_HOME}</unit.java.home>
                <tested.keycloak.version>20.0.5</tested.keycloak.version>
                <kc.test.undertow.version>20.0.5</kc.test.undertow.version>
                <tested.server.java>17</tested.server.java>
            </properties>
        </profile>
        <profile>
            <id>keycloak21</id>
            <modules>
                <module>runtime-modern</module>
                <module>runtime-modern/21</module>
            </modules>
            <properties>
                <unit.java.home>${env.JAVA11_HOME}</unit.java.home>
                <tested.keycloak.version>21.1.2</tested.keycloak.version>
                <kc.test.undertow.version>21.1.2</kc.test.undertow.version>
                <tested.server.java>17</tested.server.java>
            </properties>
        </profile>
        <profile>
            <id>keycloak22</id>
            <modules>
                <module>runtime-modern</module>
                <module>runtime-modern/22</module>
            </modules>
            <properties>
                <unit.java.home>${env.JAVA11_HOME}</unit.java.home>
                <tested.keycloak.version>22.0.5</tested.keycloak.version>
                <kc.test.undertow.version>22.0.5</kc.test.undertow.version>
                <tested.server.java>17</tested.server.java>
            </properties>
        </profile>
        <profile>
            <id>keycloak23</id>
            <modules>
                <module>runtime-modern</module>
                <module>runtime-modern/23</module>
            </modules>
            <properties>
                <unit.java.home>${env.JAVA11_HOME}</unit.java.home>
                <tested.keycloak.version>23.0.7</tested.keycloak.version>
                <kc.test.undertow.version>23.0.7</kc.test.undertow.version>
                <tested.server.java>17</tested.server.java>
            </properties>
        </profile>
        <profile>
            <id>keycloak24</id>
            <modules>
                <module>runtime-modern</module>
                <module>runtime-modern/24</module>
            </modules>
            <properties>
                <unit.java.home>${env.JAVA11_HOME}</unit.java.home>
                <tested.keycloak.version>24.0.5</tested.keycloak.version>
                <kc.test.undertow.version>24.0.5</kc.test.undertow.version>
                <tested.server.java>17</tested.server.java>
            </properties>
        </profile>
        <profile>
            <id>keycloak25</id>
            <modules>
                <module>runtime-modern</module>
                <module>runtime-modern/25</module>
            </modules>
            <properties>
                <unit.java.home>${env.JAVA11_HOME}</unit.java.home>
                <tested.keycloak.version>25.0.6</tested.keycloak.version>
                <kc.test.undertow.version>25.0.6</kc.test.undertow.version>
                <tested.server.java>21</tested.server.java>
            </properties>
        </profile>
        <profile>
            <id>keycloak26</id>
            <modules>
                <module>runtime-modern</module>
                <module>runtime-modern/26</module>
            </modules>
            <properties>
                <unit.java.home>${env.JAVA11_HOME}</unit.java.home>
                <tested.keycloak.version>26.8.2</tested.keycloak.version>
                <kc.test.undertow.version>26.8.2</kc.test.undertow.version>
                <tested.server.java>25</tested.server.java>
            </properties>
        </profile>
        <profile>
            <id>all-runtimes</id>
            <modules>
                <module>runtime-modern</module>
                <module>runtime-modern/20</module>
                <module>runtime-modern/21</module>
                <module>runtime-modern/22</module>
                <module>runtime-modern/23</module>
                <module>runtime-modern/24</module>
                <module>runtime-modern/25</module>
                <module>runtime-modern/26</module>
            </modules>
        </profile>
    </profiles>
    <developers>
        <developer>
            <id>wadahiro</id>
            <name>Hiroyuki Wada</name>
            <url>https://github.com/wadahiro</url>
        </developer>
    </developers>
    <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/wadahiro/keycloak-test-framework-extensions.git</connection>
        <developerConnection>scm:git:git@github.com:wadahiro/keycloak-test-framework-extensions.git</developerConnection>
        <url>https://github.com/wadahiro/keycloak-test-framework-extensions</url>
    </scm>
</project>
